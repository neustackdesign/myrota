{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myrota-staging",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myrota-staging",
      "database_id": "c003a749-1f1a-454e-aad9-bedd067cc7b1",
      "migrations_dir": "db/migrations"
    }
  ],
  // Workers AI binding for Phase 3 label reading. Present here so env.AI exists,
  // but photoReading stays OFF until PHOTO_READING_ENABLED=1 after the 30-label
  // benchmark passes. Isolated to staging; production config is untouched.
  "ai": {
    "binding": "AI"
  }
}
