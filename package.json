{
  "name": "myrota-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "build:web": "npm run build -w @myrota/web",
    "build:api": "npm run build:vinext -w @myrota/api",
    "typecheck": "npm run typecheck -w @myrota/web && npm run typecheck -w @myrota/api",
    "test:domain": "npm run test:domain -w @myrota/api",
    "test:backend": "npm run test:backend -w @myrota/api",
    "deploy:staging": "npm run deploy:staging -w @myrota/api"
  }
}
